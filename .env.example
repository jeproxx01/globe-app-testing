# Globe Testing Environment Variables
# Copy this to .env and fill in your values

# Base URL (default: https://shop.globe.com.ph/)
BASE_URL=https://shop.globe.com.ph/

# CI mode (set to true in CI environments)
CI=false

# Debug mode
DEBUG=false

# Jira API credentials
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
